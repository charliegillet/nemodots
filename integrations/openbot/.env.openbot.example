# integrations/openbot/.env.openbot — written by `bash integrations/openbot/setup.sh` (mode 600,
# ignored by git through the `.env.*` rule). Copy this file only if you want to set values by hand.
# The Crusoe key is NOT here: only crusoe_proxy.py reads it, from the repo's .env.

# Shared secret between Ratchet (the AG-UI surface) and agent-bot; sent as `x-openbot-agent-token`.
# setup.sh generates it with `openssl rand -hex 32` when empty.
MANAGED_AGENT_TOKEN=

# Optional overrides (defaults shown in comments).
# OPENBOT_AGENT_URL=            # http://127.0.0.1:4200/ag-ui
# OPENBOT_PROXY_URL=            # http://127.0.0.1:8787
# OPENBOT_SERVER_URL=           # http://127.0.0.1:3001   (stack mode)
# OPENBOT_APP_ORIGIN=           # http://localhost:3010   (stack mode, same-origin writes)
# OPENBOT_BOT_ID=               # ratchet-coworker        (stack mode)
# OPENBOT_AGENT_PORT=           # 4200
# OPENBOT_PROXY_PORT=           # 8787

# Stack mode only. CopilotKit Intelligence: the OpenBot server refuses to start without all three.
# The key needs a CopilotKit account (`npx copilotkit@latest login`), which Ratchet will not create.
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
INTELLIGENCE_API_KEY=
