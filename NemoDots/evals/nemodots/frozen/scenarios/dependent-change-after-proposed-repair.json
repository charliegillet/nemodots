  "expected": {
    "mustCommitAtLeastOne": false,
    "finalPredicates": [
      {
        "kind": "verifier_probe_pass"
      },
      {
        "kind": "health_ok_window"
      },
      {
        "kind": "keys_outside_allowed_unchanged"
      },
      {
        "kind": "trial_key_predicates"
      },
      {
        "kind": "honest_disjunction",
        "definition": "record which branch occurred: (a) the dependent intent blocked(stale_version | stale_pending_observation) at admission or commit, or (b) it committed before the change and the change produced a second invalidation and repair"
