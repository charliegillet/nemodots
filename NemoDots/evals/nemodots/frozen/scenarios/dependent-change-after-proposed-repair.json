    },
    {
      "trialId": "fz-dc-3",
      "seed": 10259,
      "faultClass": "F4",
      "missionOptions": {
        "admissionMinAgeMs": 3000
      },
      "steps": [
        {
          "trigger": {
            "kind": "at_ms",
            "ms": 3000
          },
          "key": "routing.inventory_source",
          "value": "replica_stale",
          "actor": "injector"
        },
        {
          "trigger": {
            "kind": "on_action_proposed",
            "key": "routing.inventory_source",
            "delayMs": 1500
          },
          "key": "routing.inventory_source",
          "value": "replica_stale",
          "actor": "injector"
