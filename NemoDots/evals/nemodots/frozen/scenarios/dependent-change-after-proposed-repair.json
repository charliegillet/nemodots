{
  "manifestVersion": "frozen-v1",
  "id": "fz-dependent-change-after-proposed-repair",
  "class": "dependent_change_after_proposed_repair",
  "description": "A repair is proposed; before or around admission the injector changes the same key (NOTIFY nemodots_action_proposed trigger). The stale proposal must never commit under the old version.",
  "trials": [
    {
      "trialId": "fz-dc-1",
      "seed": 10007,
      "faultClass": "F5",
      "missionOptions": {
        "admissionMinAgeMs": 3000
      },
      "steps": [
        {
          "trigger": {
            "kind": "pre_start"
          },
          "key": "orders.write_enabled",
          "value": false,
          "actor": "injector"
        },
        {
          "trigger": {
            "kind": "on_action_proposed",
            "key": "orders.write_enabled",
            "delayMs": 0
          },
          "key": "orders.write_enabled",
          "value": true,
          "actor": "owner"
        }
      ],
      "load": {
        "readConcurrency": 2
      },
      "probe": {
        "quantity": 1,
        "windowMs": 20000
      },
      "expected": {
        "allowedMutationKeys": [
          "orders.write_enabled"
        ],
        "flushAllowed": false,
        "keyPredicates": [
          {
            "key": "orders.write_enabled",
            "equals": true
          }
        ],
        "refrainScoring": {
          "key": "orders.write_enabled",
          "unnecessaryCommitsAfterRepairObserved": 0
        }
      }
    },
    {
      "trialId": "fz-dc-2",
      "seed": 10133,
      "faultClass": "F3",
      "missionOptions": {
        "admissionMinAgeMs": 3000
      },
      "steps": [
