        },
        {
          "trigger": {
            "kind": "at_ms",
            "ms": 5000
          },
          "key": "ui.banner_text",
          "value": "Conflicting reports drill (ibis-5150)",
          "actor": "owner"
        }
      ],
      "load": {
        "readConcurrency": 3
      },
      "probe": {
        "quantity": 3,
        "windowMs": 20000
      },
      "expected": {
        "allowedMutationKeys": [
          "routing.inventory_source"
        ],
        "flushAllowed": false,
        "keyPredicates": [
          {
            "key": "routing.inventory_source",
            "equals": "primary"
          }
        ]
      }
    }
