  "expected": {
    "mustCommitAtLeastOne": false,
    "finalPredicates": [
      {
        "kind": "verifier_probe_pass"
      },
      {
        "kind": "health_ok_window"
      },
      {
        "kind": "keys_outside_allowed_unchanged"
      },
      {
        "kind": "trial_key_predicates"
      },
      {
        "kind": "no_resurrection"
      }
    ],
    "successOutcome": "no commit against superseded or contested support; final state repaired"
  }
