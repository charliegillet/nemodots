CRUSOE_API_KEY=""
CRUSOE_BASE_URL="https://api.inference.crusoecloud.com/v1"

# You.com Search API key (X-API-Key for https://ydc-index.io/v1/search; Bearer for the MCP server in .mcp.json).
# The You.com SDK/docs call this YDC_API_KEY; Ratchet reads YOU_API_KEY first, then YDC_API_KEY.
YOU_API_KEY=

# Optional: Crusoe Cloud MCP / CLI (needs ~/.crusoe/config from `crusoe config init` with cloud access keys,
# which are NOT the inference key). Leave blank to use the config-file defaults.
CRUSOE_PROFILE=
CRUSOE_PROJECT=

# Optional: CopilotKit Intelligence project key, needed only for the full OpenBot stack
# (integrations/openbot/setup.sh --stack, --openbot-mode stack). The default OpenBot host mode (agui) and the
# local worker do not use it. OpenBot's own `copilotkit project select` writes it as CPK_INTELLIGENCE_API_KEY,
# which Ratchet accepts as an alias; set one of the two, not both. Ratchet never creates the account: without a
# key, stack mode reports a BLOCKER and everything else works.
INTELLIGENCE_API_KEY=
